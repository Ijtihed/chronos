# ---------------------------------------------------------------------------
# Gemini — required for all LLM calls
# ---------------------------------------------------------------------------
# Get a key from https://aistudio.google.com/app/apikey.
# Without this key all LLM calls return a canned "..." (NoOp) response.
GEMINI_API_KEY=

# Optional overrides.
# CHRONOS_GEMINI_MODEL=gemini-2.5-flash-lite   # default; change if you have access to a newer preview
# CHRONOS_GEMINI_MAX_CONCURRENT=15             # max concurrent in-flight requests; hard-capped at 20
